# Eine Seite, eine Adresse. Ohne diese beiden Umleitungen ist die Startseite
# unter vier Adressen erreichbar — mit und ohne `www`, mit und ohne
# `index.html` —, und welche davon in der Suche erscheint, entscheidet dann
# Google statt uns. Das `canonical` im Kopf sagt es zwar, aber es ist ein
# Hinweis; eine 301 ist eine Auskunft.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www → ohne www. Das Zertifikat deckt beide Namen ab, deshalb fällt das
  # sonst nicht auf: die Seite antwortet unter www einfach mit.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # /index.html → /. Nur bei einer echten Anfrage von außen, sonst dreht sich
  # die Regel im Kreis, sobald Apache den Ordner intern auf index.html
  # auflöst.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # Seiten werden gegen den Stand auf dem Server geprüft: der Browser darf
  # cachen, fragt aber vor jeder Nutzung nach und bekommt 304, solange sich
  # nichts geändert hat. Ohne diesen Header rät er die Frische aus dem Alter
  # der Datei — und zeigt nach einem Upload eine Mischung aus altem und neuem
  # Stand (neue Seite mit alter style.css: das Sprachmenü zerfiel zur
  # Rohliste).
  Header set Cache-Control "no-cache"

  # **Bilder werden geprüft wie Seiten, nicht eine Woche lang geglaubt.**
  # Hier stand `max-age=604800` mit der Begründung, Abbildungen änderten sich
  # praktisch nie und hießen stabil. Der zweite Teil stimmt — genau deshalb
  # fragt der Browser bei einer Woche gar nicht erst nach: `catalog.png` heißt
  # nach jedem Lauf wieder so. Der erste Teil ist am 25.08.2026 gefallen, als
  # dieselben Bilder zweimal an einem Tag neu entstanden: Der Server lieferte
  # längst die neuen, und im Browser stand die alte Fassung.
  #
  # Was das kostet, ist eine bedingte Anfrage je Bild und Seitenaufruf, die
  # mit 304 und ein paar hundert Byte beantwortet wird — die Bilddaten
  # bleiben im Cache. Was es einbringt, ist die Zusage, dass niemand eine
  # Oberfläche sieht, die es nicht mehr gibt. Schriften bleiben bei einer
  # Woche: Eine woff2 ändert sich wirklich nie.
  <FilesMatch "\.(png|jpg|jpeg|webp|avif|svg|ico)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Nichts, was der Browser raten müsste, und keine Adresse, die beim
  # Weggehen mitgereicht wird.
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Kompression. Der Server macht es für HTML von sich aus, für SVG und JSON
# nicht überall — und gerade das Handbuch besteht aus 229 SVG-Dateien.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# Die Sitemap und llms.txt sollen als das ankommen, was sie sind.
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddCharset UTF-8 .txt .xml .json
</IfModule>
