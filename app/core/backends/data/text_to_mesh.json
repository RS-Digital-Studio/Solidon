{
  "1": {
    "class_type": "Hy3DModelLoader",
    "inputs": {
      "model": "hunyuan3d-dit-v2-mini-turbo",
      "attention_mode": "sdpa"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{prompt}",
      "clip": ["1", 1]
    }
  },
  "3": {
    "class_type": "Hy3DGenerateMesh",
    "inputs": {
      "pipeline": ["1", 0],
      "conditioning": ["2", 0],
      "seed": "{seed}",
      "steps": 30,
      "guidance_scale": 5.0
    }
  },
  "4": {
    "class_type": "Hy3DExportMesh",
    "inputs": {
      "trimesh": ["3", 0],
      "filename_prefix": "formwerk/text",
      "file_format": "glb"
    }
  }
}
