{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{image}",
      "upload": "image"
    }
  },
  "2": {
    "class_type": "RMBG",
    "inputs": {
      "image": [
        "1",
        0
      ],
      "model": "INSPYRENET",
      "sensitivity": 1.0,
      "process_res": 1024,
      "mask_blur": 0,
      "mask_offset": 0,
      "invert_output": false,
      "refine_foreground": true,
      "background": "Color",
      "background_color": "#FFFFFF"
    }
  },
  "3": {
    "class_type": "TripoSGLoader",
    "inputs": {
      "model": "{model:shape}",
      "precision": "float16"
    }
  },
  "4": {
    "class_type": "TripoSGImageToMesh",
    "inputs": {
      "pipeline": [
        "3",
        0
      ],
      "image": [
        "2",
        0
      ],
      "mask": [
        "2",
        1
      ],
      "steps": 50,
      "guidance_scale": 7.0,
      "seed": "{seed}",
      "octree_depth": 8,
      "crop_margin": 0.1
    }
  },
  "5": {
    "class_type": "TripoSGPostprocess",
    "inputs": {
      "mesh": [
        "4",
        0
      ],
      "keep_largest_only": true,
      "remove_degenerate": true,
      "target_faces": 0
    }
  },
  "6": {
    "class_type": "TripoSGExportMesh",
    "inputs": {
      "mesh": [
        "5",
        0
      ],
      "filename_prefix": "solidon/image",
      "file_format": "glb"
    }
  }
}
