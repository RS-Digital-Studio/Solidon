#!/usr/bin/env bash
# Vor jedem Commit an app/ oder tools/: Bezeichner und neue Katalogtexte.
#
# Warum diese Prüfungen als Hook: Am 30.08.2026 ist dreimal
# dieselbe Sache schiefgegangen — einmal mittags, einmal abends, einmal in
# einer dritten Sitzung. Jedes Mal ging ein neuer `tr()`-Text oder ein
# deutscher Bezeichner nach origin, jedes Mal stand das Tor danach für alle
# rot, und jedes Mal war der Grund derselbe: **Der Fehler ist im eigenen Diff
# unsichtbar.** Ein fehlender Katalogeintrag steht in fünf Dateien, die man
# gerade *nicht* angefasst hat; die angesagte Zeilenzahl je Datei kann ihn
# also nicht fangen. Ein Reflex, der dreimal an einem Tag versagt, gehört ins
# Werkzeug und nicht in drei Köpfe.
#
# Die Bezeichnerprüfung läuft ohne Fenster. Neue Texte prüft der vorhandene
# Index-Wächter direkt gegen die Kataloge; Fensterdateien wie
# test_translations.py und Leistungsprüfungen laufen nur beim Release.
#
# **Was dieser Hook ausdrücklich nicht tut: fremde Arbeit anrechnen.** An
# diesem Projekt arbeiten bis zu fünf Sitzungen im selben Arbeitsbaum. Die
# Bezeichnertests laufen gegen den Baum und sehen deshalb auch, was andere
# gerade ungestaged liegen haben. Ein Hook, der darauf blockiert, hielte jemanden von
# seinem eigenen, sauberen Commit ab — und wäre nach dem zweiten Mal
# dauerhaft abgeschaltet. Er prüft deshalb bei jedem Befund, ob die
# betroffene Datei **in diesem Commit** steht. Nur eindeutig fremde normale
# Testfehler dürfen weiterlaufen; eine kaputte oder nicht auswertbare Prüfung
# hält den Commit an.

set -u

if [ "${SOLIDON_KEIN_TOR:-}" = "1" ]; then
  echo "pre-commit: SOLIDON_KEIN_TOR=1, keine Sprachprüfung." >&2
  exit 0
fi

# Was dieser Commit mitnimmt. `--cached` und nicht der Arbeitsbaum: Im
# geteilten Baum ist genau das der Unterschied zwischen meiner Arbeit und der
# aller anderen.
protokoll=$(mktemp) || {
  echo "pre-commit: ABGEBROCHEN — kein temporäres Prüfprotokoll möglich." >&2
  exit 1
}
trap 'rm -f -- "$protokoll"' EXIT
if ! git diff --cached --name-only -z --diff-filter=ACMR > "$protokoll"; then
  echo "pre-commit: ABGEBROCHEN — gestagte Dateien konnten nicht gelesen werden." >&2
  exit 1
fi
gestaged=()
code_betroffen=0
while IFS= read -r -d '' pfad; do
  gestaged+=("$pfad")
  case "$pfad" in
    app/*.py|tools/*.py) code_betroffen=1 ;;
  esac
done < "$protokoll"

# Nur wenn ausgelieferter Code betroffen ist. Ein Commit an ROADMAP.md,
# konzepte/ oder tests/ kann keinen deutschen Bezeichner in app/ einführen und
# keinen Katalogtext schuldig bleiben.
if [ "$code_betroffen" -eq 0 ]; then
  exit 0
fi

# **Die Umgebung liegt am Hauptklon, nicht am Arbeitsverzeichnis.** Die
# Prüfläufe und die Agentensitzungen dieses Projekts arbeiten in
# `git worktree`-Bäumen unter `.claude/worktrees/`; dort gibt es keine `.venv`,
# und ein relativer Pfad fand sie nicht. Der Hook lief trotzdem — `hooksPath`
# steht absolut —, meldete „keine .venv gefunden" und ließ jeden Commit durch.
# Damit war die Sprachprüfung genau dort abgeschaltet, wo mehrere Sitzungen
# nebeneinander committen (gemessen am 13.09.2026 in
# `.claude/worktrees/agent-…`: `ls .venv` → nicht vorhanden,
# `core.hooksPath` → `F:\3D Druck\.githooks`).
gitverzeichnis=$(git rev-parse --path-format=absolute --git-common-dir) || {
  echo "pre-commit: ABGEBROCHEN — Hauptklon konnte nicht ermittelt werden." >&2
  exit 1
}
wurzel=$(dirname "$gitverzeichnis")
python="$wurzel/.venv/Scripts/python.exe"
[ -x "$python" ] || python="$wurzel/.venv/bin/python"
[ -x "$python" ] || {
  echo "pre-commit: ABGEBROCHEN — keine .venv unter $wurzel gefunden." >&2
  exit 1
}

echo "pre-commit: Sprachprüfungen …" >&2
"$python" -m pytest tests/test_language_rules.py \
  -q --no-header -p no:randomly -r fE --color=no --maxfail=0 > "$protokoll" 2>&1
code=$?

meine=""
prueffehler=""
if [ "$code" -ne 0 ]; then
  echo "" >&2
  echo "pre-commit: die Bezeichnerprüfung ist rot (Exit $code). Ausgabe:" >&2
  tail -n 40 "$protokoll" >&2
  echo "" >&2

  if [ "$code" -ne 1 ]; then
    prueffehler="Die Bezeichnerprüfung konnte nicht regulär abgeschlossen werden (Exit $code)."
  else
    # Nur vollständige FAILED-Parameter-IDs sind Dateibelege. Meldungstexte,
    # bestandene Tests, gleiche Basenames und Namenssuffixe zählen nicht.
    # Unbekannte Tests, fehlende Dateien und maskierte/mehrdeutige IDs halten
    # an, statt aus einer fehlenden Zuordnung fremde Arbeit zu folgern.
    fehlermuster='^FAILED tests/test_language_rules\.py::test_identifiers_are_english\[([^][]+)\]( - .*)?$'
    befunde=0
    while IFS= read -r zeile || [ -n "$zeile" ]; do
      zeile=${zeile%$'\r'}
      case "$zeile" in
        FAILED*)
          if [[ ! "$zeile" =~ $fehlermuster ]]; then
            prueffehler="Ein fehlgeschlagener Test lässt sich keiner Quelldatei zuordnen."
            continue
          fi
          pfad=${BASH_REMATCH[1]}
          if [[ "$pfad" != app/*.py && "$pfad" != tools/*.py ]] \
            || [[ "$pfad" == *'\'* ]] || [ ! -f "$pfad" ]; then
            prueffehler="Ein fehlgeschlagener Test trägt keinen eindeutigen vorhandenen Quellpfad."
            continue
          fi
          befunde=$((befunde + 1))
          for eigene_datei in "${gestaged[@]}"; do
            if [ "$pfad" = "$eigene_datei" ]; then
              meine="$meine $pfad"
            fi
          done
          ;;
        ERROR*) prueffehler="Die Bezeichnerprüfung meldet einen Ausführungsfehler." ;;
      esac
    done < "$protokoll"
    if [ "$befunde" -eq 0 ]; then
      prueffehler="Die rote Bezeichnerprüfung enthält keine zuordenbaren Dateibefunde."
    fi
  fi
fi

# Neue Texte werden immer geprüft, auch bei grünen Bezeichnern. Der Wächter
# liest Index gegen HEAD und fragt nur diese Texte gegen die Kataloge ab.
# Eine fremde Kataloglücke gehört dadurch nicht zu diesem Commit; die Ausgabe
# einer Fensterprüfung wird weder gestartet noch als Schalter ausgewertet.
neu_und_offen=$("$python" tools/check_new_texts.py 2>&1)
case $? in
  0) ;;
  2)
    prueffehler="${prueffehler:-Die Textprüfung konnte eine gestagte Datei nicht lesen.}"
    echo "$neu_und_offen" >&2
    ;;
  *)
    meine="$meine [neue Texte ohne Übersetzung]"
    echo "$neu_und_offen" >&2
    ;;
esac

if [ -n "$prueffehler" ]; then
  echo "pre-commit: ABGEBROCHEN — $prueffehler" >&2
  exit 1
fi

if [ -n "$meine" ]; then
  echo "pre-commit: ABGEBROCHEN — betroffen sind Dateien aus diesem Commit:" >&2
  echo "pre-commit:  $meine" >&2
  echo "pre-commit: Behebe es und committe erneut." >&2
  exit 1
fi

if [ "$code" -eq 0 ]; then
  echo "pre-commit: Bezeichner und neue Katalogtexte sind in Ordnung." >&2
  exit 0
fi

echo "pre-commit: Alle fehlgeschlagenen Bezeichnertests betreffen Dateien" >&2
echo "pre-commit: außerhalb dieses Commits. Der Commit läuft weiter." >&2
exit 0
