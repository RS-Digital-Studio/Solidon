<?xml version="1.0" encoding="utf-8"?>
<!-- Erzeugt von tools/make_macos_package.py — Werte aus app/branding.py. -->
<installer-gui-script minSpecVersion="2">
    <title>Solidon3D 0.1.4</title>
    <organization>de.rsdigital</organization>
    <license file="eula.txt" mime-type="text/plain" />
    <conclusion file="conclusion.txt" mime-type="text/plain" />
    <options customize="allow" require-scripts="false" hostArchitectures="arm64" />
    <domains enable_anywhere="true" enable_currentUserHome="true" enable_localSystem="true" />
    <volume-check>
        <allowed-os-versions><os-version min="12.0" /></allowed-os-versions>
    </volume-check>
    <pkg-ref id="de.rsdigital.solidon3d" version="0.1.4">component.pkg</pkg-ref>
    <choices-outline>
        <line choice="de.rsdigital.solidon3d" />
    </choices-outline>
    <choice id="de.rsdigital.solidon3d" title="Solidon3D" visible="true" description="Solidon3D 0.1.4 — RS Digital">
        <pkg-ref id="de.rsdigital.solidon3d" />
    </choice>
</installer-gui-script>
