+    from_the_rib = [feature for feature in detected if feature.shaped_by == 2]
+    from_the_plate = [feature for feature in detected if feature.shaped_by == 1]
+    assert from_the_rib, "eine erkannte Fläche der Rippe stammt aus dem Rippenschritt"
+    assert from_the_plate, "und die der Platte weiter aus dem ersten"
+    assert all(feature.created_by is None for feature in from_the_rib), (
+        "der Erzeuger bleibt frei — die drei Riegel gelten weiter"
+    )
