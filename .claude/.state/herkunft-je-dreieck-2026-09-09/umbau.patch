+def carry_origins(result: MeshData, sources: list[MeshData], *, made_by: int) -> MeshData:
+    """Jedem Dreieck den Schritt geben, aus dessen Oberfläche es stammt (§21.2).
+
+    Dieselbe Frage wie bei den Slots, eine Ebene höher: Ein Dreieck, das auf
+    der Oberfläche eines Eingangs sitzt, gehört zu dessen Herkunft; jedes
+    andere ist in **dieser** Operation entstanden und bekommt ``made_by``.
+
+    **Warum nicht einfach „was neu ist, gehört der Operation".** Gemessen an
+    einer Rippe auf einer Platte (09.09.2026): Von 28 Dreiecken der Vereinigung
+    waren nur zwölf Ecke für Ecke unverändert. Unter den sechzehn übrigen ist
+    die Rippe — aber eben auch die Plattenoberseite, die um sie herum neu
+    vernetzt wurde. Sie der Rippe zuzuschlagen hieße, die Oberseite des Halters
+    unter „Versteifungsrippe" zu hängen.
+
+    **Und warum die exakte Runde trotzdem zuerst läuft.** Sie ist ein
+    Wörterbuchzugriff und beantwortet den größten Teil: Je kleiner der Eingriff
+    im Verhältnis zum Körper, desto mehr Dreiecke bleiben, wie sie waren. Die
+    teure Suche nach der nächsten Oberfläche bleibt damit auf den Saum des
+    Eingriffs beschränkt statt auf das ganze Netz — bei einem gescannten Teil
+    mit vierzigtausend Dreiecken ist das der Unterschied zwischen Sekunden und
+    Millisekunden.
+
+    Ohne Eingänge — ein Erzeuger ohne Vorgänger — trägt alles ``made_by``.
+    """
+    body = result.raw
+    count = len(body.faces)
+    if not count:
+        return result
+
+    origins = np.full(count, int(made_by), dtype=np.int32)
+    known = [mesh for mesh in sources if mesh.origins and len(mesh.origins) == len(mesh.raw.faces)]
+    if known:
+        open_rows = _exact_origins(body, known, origins)
+        if 0 < open_rows.size <= _SEARCH_LIMIT_ROWS:
+            _near_origins(result, known, origins, open_rows)
+
+    return MeshData(
+        raw=body,
+        slots=result.slots,
+        cavity=result.cavity,
+        # ``tolist`` und nicht ``int`` je Element: Der Umweg über einen
+        # Generator kostete am Dosenbeispiel mit seinen 41 434 Dreiecken
+        # mehr als die Zuordnung selbst.
+        origins=tuple(origins.tolist()),
+    )
+
+
+def _exact_origins(
+    body: trimesh.Trimesh, sources: list[MeshData], origins: np.ndarray
+) -> np.ndarray:
+    """Die Dreiecke, die Ecke für Ecke aus einem Eingang stammen, direkt zuordnen.
+
+    Gibt zurück, welche Zeilen dabei offen geblieben sind. Verglichen wird das
+    gerundete Eckentripel ohne Reihenfolge: Eine Boolesche Operation darf
+    dasselbe Dreieck anders herum ausgeben, und es ist trotzdem dasselbe.
+    """
+    keys = [_triangle_keys(mesh.raw) for mesh in sources]
+    if not any(entry.size for entry in keys):
+        return np.arange(len(body.faces), dtype=np.intp)
+    known = np.concatenate(keys)
+    from_where = np.concatenate([np.asarray(mesh.origins, dtype=np.int32) for mesh in sources])
+    # Sortiert nachschlagen statt Zeile für Zeile fragen. Die Python-Fassung
+    # davon hat das mehrfarbige Beispiel von 1,2 auf 13,4 Sekunden gebracht
+    # (gemessen 09.09.2026) — bei vierzigtausend Dreiecken ist eine Schleife
+    # über Tupel kein Vorfilter mehr, sondern die Rechnung selbst.
+    order = np.argsort(known, kind="stable")
+    sorted_keys = known[order]
+
+    wanted = _triangle_keys(body)
+    place = np.searchsorted(sorted_keys, wanted)
+    place = np.clip(place, 0, len(sorted_keys) - 1)
+    hit = sorted_keys[place] == wanted
+    origins[hit] = from_where[order[place[hit]]]
+    return np.flatnonzero(~hit).astype(np.intp)
+
+
+def _triangle_keys(mesh: trimesh.Trimesh) -> np.ndarray:
+    """Jedes Dreieck als **ein** vergleichbarer Wert, unabhängig von der Eckenfolge.
+
+    Gerundet auf :data:`_EXACT_DIGITS`, in ganze Zahlen gelegt und je Dreieck
+    lexikographisch sortiert: Eine Boolesche Operation darf dasselbe Dreieck
+    anders herum ausgeben, und es bleibt dasselbe. Die neun Zahlen werden als
+    ein roher Speicherblock angesehen — darauf sortiert und sucht numpy in
+    einem Zug, statt neun Spalten einzeln zu vergleichen.
+    """
+    faces = np.asarray(mesh.faces, dtype=np.int64)
+    if not len(faces):
+        return np.empty(0, dtype=np.dtype((np.void, 72)))
+    corners = np.asarray(mesh.vertices, dtype=float)[faces]
+    scaled = np.rint(corners * (10.0**_EXACT_DIGITS)).astype(np.int64)
+    order = np.lexsort((scaled[:, :, 2], scaled[:, :, 1], scaled[:, :, 0]), axis=1)
+    ordered = np.take_along_axis(scaled, order[:, :, None], axis=1)
+    flat = np.ascontiguousarray(ordered.reshape(len(faces), 9))
+    return flat.view(np.dtype((np.void, flat.dtype.itemsize * 9))).ravel()
+
+
+def _near_origins(
+    result: MeshData, sources: list[MeshData], origins: np.ndarray, rows: np.ndarray
+) -> None:
+    """Für den Saum: die Herkunft der nächsten Oberfläche, wenn sie nah genug liegt.
+
+    Dieselbe Grenze wie bei den Slots (:data:`NEAR_LIMIT`) und dieselbe
+    Begründung: Gemessen wird zur *Oberfläche*, nicht zum nächsten
+    Dreiecksmittelpunkt — eine Boolesche Operation teilt eine große Fläche in
+    viele kleine, deren Mittelpunkte weit von dem der Fläche liegen, aus der
+    sie kamen.
+    """
+    from app.core.geom.mesh import on_surface
+
+    points = np.asarray(result.raw.triangles_center, dtype=float)[rows]
+    limit = max(result.bounds.diagonal, 1.0) * NEAR_LIMIT
+    best = np.full(len(rows), np.inf)
+    for mesh in sources:
+        _closest, distance, triangle = on_surface(mesh.raw, points)
+        closer = distance < best
+        found = np.asarray(mesh.origins, dtype=np.int32)[triangle]
+        origins[rows[closer]] = np.where(
+            distance[closer] <= limit, found[closer], origins[rows[closer]]
+        )
+        best[closer] = distance[closer]
