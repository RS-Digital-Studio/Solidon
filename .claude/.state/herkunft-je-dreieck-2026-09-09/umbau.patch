+def with_origin(mesh: MeshData, made_by: int) -> MeshData:
+    """Ein ganzer Körper aus einem Schritt — der Ausgangszustand jeder Probe."""
+    return MeshData(
+        raw=mesh.raw,
+        slots=mesh.slots,
+        cavity=mesh.cavity,
+        origins=tuple([int(made_by)] * mesh.triangle_count),
+    )
+
+
+def test_the_origin_of_a_new_body_is_the_step_that_made_it() -> None:
+    """Ohne Eingänge trägt jedes Dreieck den Schritt, der es erzeugt hat."""
+    stamped = carry_origins(cube(), [], made_by=7)
+
+    assert stamped.origins == (7,) * stamped.triangle_count
+
+
+def test_an_untouched_surface_keeps_the_step_it_came_from() -> None:
+    """Der Fall, um den es geht: eine Rippe auf einer Platte (Robert, 09.09.2026).
+
+    Die Vereinigung vernetzt den Saum neu, und dabei entstehen Dreiecke, die es
+    vorher nicht gab — auf der Rippe **und** auf der Plattenoberseite um sie
+    herum. Wer alles Neue der Rippe zuschlägt, hängt die Oberseite des Halters
+    unter „Versteifungsrippe". Gemessen wird deshalb, dass die Fläche
+    entscheidet und nicht die Neuheit.
+    """
+    plate = with_origin(cube(size=40.0), 1)
+    rib = trimesh.creation.box(extents=(2.0, 30.0, 8.0))
+    rib.apply_translation((0.0, 0.0, 20.0))
+
+    joined = boolean("union", [plate, MeshData.of(rib)])
+    stamped = carry_origins(joined.mesh, [plate], made_by=2)
+
+    assert len(stamped.origins) == stamped.triangle_count
+    assert set(stamped.origins) == {1, 2}, "beide Schritte kommen im Ergebnis vor"
+
+    # Die Unterseite der Platte hat die Vereinigung nicht angefasst — sie
+    # gehört weiter dem Schritt, der die Platte gemacht hat.
+    centres = np.asarray(stamped.raw.triangles_center, dtype=float)
+    bottom = centres[:, 2] < -19.0
+    assert bottom.any(), "ohne Unterseite prüft der Test nichts"
+    assert set(np.asarray(stamped.origins)[bottom]) == {1}
+
+    # Und die Rippe steht oben heraus, wo vorher nichts war.
+    above = centres[:, 2] > 21.0
+    assert above.any(), "ohne Rippe prüft der Test nichts"
+    assert set(np.asarray(stamped.origins)[above]) == {2}
+
+
+def test_the_origin_survives_the_plate_cache() -> None:
+    """Sonst hinge dieselbe Fläche je nach Cachetreffer woanders."""
+    stamped = carry_origins(cube(), [], made_by=4)
+
+    again = MeshData.from_bytes(stamped.to_bytes())
+
+    assert again.origins == stamped.origins
+
+
+def test_a_stand_without_origins_stays_readable() -> None:
+    """Ein Cachestand aus der Zeit davor trägt den Schlüssel nicht."""
+    plain = MeshData.from_bytes(cube().to_bytes())
+
+    assert plain.origins == ()
