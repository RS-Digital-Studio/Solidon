+def _from_the_mesh(features: dict[str, Any], mesh: Any) -> dict[str, Any]:
+    """Jedem Merkmal den Schritt eintragen, aus dem seine Dreiecke stammen.
+
+    Das ist ``shaped_by`` und ausdrücklich **nicht** ``created_by``. Die beiden
+    beantworten verschiedene Fragen, und die Unterscheidung ist hier teuer
+    erkauft: Drei Tests halten fest, dass ein erkanntes Merkmal keinen
+    *Erzeuger* bekommt — die Innenfläche eines Aushöhl-Schritts nicht, ein
+    umstrittener Zuordnungskandidat nicht, eine Fläche nach dem Laden nicht.
+    Diese Riegel bleiben, wo sie sind. Wer die Dreiecke gebaut hat, ist eine
+    Auskunft über die Geometrie und keine über die Verantwortung.
+
+    **Die Mehrheit muss klar sein.** Eine Fläche am Saum eines Eingriffs trägt
+    Dreiecke aus zwei Schritten; wo keiner mehr als die Hälfte hält, bleibt es
+    bei ``None``. Lieber keine Auskunft als eine geratene (Regel 21).
+    """
+    origins = getattr(mesh, "origins", ())
+    if not origins:
+        return features
+    known = np.asarray(origins, dtype=np.int64)
+    result = dict(features)
+    for name, feature in features.items():
+        if not feature.face_indices:
+            continue
+        rows = np.asarray(feature.face_indices, dtype=np.intp)
+        rows = rows[rows < len(known)]
+        if not rows.size:
+            continue
+        values, amounts = np.unique(known[rows], return_counts=True)
+        best = int(np.argmax(amounts))
+        if amounts[best] * 2 > rows.size:
+            result[name] = dataclasses.replace(feature, shaped_by=int(values[best]))
+    return result
+
+
