+    seine Zuordnung läuft über den B-Rep-Kern. Ebenso alles, was gar kein Netz
+    ist: Die Auswertung reicht hier durch, was die Operation ausgegeben hat.
+    """
+    from app.core.geom.attributes import carry_origins
+    from app.core.geom.mesh import MeshData
+
+    if not isinstance(mesh, MeshData):
+        return mesh
+    sources = [entry.mesh for entry in inputs if isinstance(entry.mesh, MeshData)]
+    return carry_origins(mesh, sources, made_by=int(made_by))
+
