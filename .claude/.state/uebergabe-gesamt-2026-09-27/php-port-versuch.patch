+def _answers(port: int) -> bool:
+    """Ob an diesem Port schon ein Server annimmt, auch einer aus einem anderen
+    Testlauf."""
+    with socket.socket() as probe:
+        probe.settimeout(0.2)
+        return probe.connect_ex(("127.0.0.1", port)) == 0
+
+
+#: Die Startzeile von PHPs eingebautem Server, mit dem Port, auf dem er lauscht.
+_STARTED = re.compile(rb"Development Server \(http://127\.0\.0\.1:(\d+)\) started")
+
+#: So lange darf ein Server brauchen, bis er seinen Port nennt, in Sekunden.
+_START_SECONDS = 15.0
+
+
+def serve(
+    command: Callable[[int], list[str]],
+    *,
+    cwd: Path | None = None,
+    env: Mapping[str, str] | None = None,
+) -> tuple[subprocess.Popen[bytes], int]:
+    """Startet PHPs eingebauten Server auf einem Port, den das System vergibt.
+
+    ``command`` baut den Aufruf zu einem Port. Gefragt wird Port 0, und PHP
+    nennt in seiner Startzeile, welchen es bekommen hat — gemessen an PHP
+    8.5.8. So wählt kein Test mehr einen Port, den ein anderer Lauf im selben
+    Augenblick ebenfalls für frei hält: Zwei Sitzungen, die die Suite zugleich
+    fuhren, teilten sich am 27.09.2026 trotz eigener Bereiche Ports, und vier
+    Tests je Lauf sprachen mit dem Server des anderen, bis der endete. Nennt
+    ein PHP seinen Port nicht, startet der Server auf :func:`free_port`.
+
+    Die Fehlerausgabe geht in eine Datei, aus der die Startzeile gelesen wird.
+    """
+    with tempfile.NamedTemporaryFile(prefix="php-server-", suffix=".log", delete=False) as log:
+        journal = Path(log.name)
+        process = subprocess.Popen(
+            command(0),
+            cwd=cwd,
+            env=None if env is None else dict(env),
+            stdout=subprocess.DEVNULL,
+            stderr=log,
+        )
+    port = 0
+    deadline = time.monotonic() + _START_SECONDS
+    while time.monotonic() < deadline and process.poll() is None:
+        found = _STARTED.search(journal.read_bytes())
+        if found:
+            port = int(found.group(1))
+            break
+        time.sleep(0.02)
+    if port > 0:
+        return process, port
+    process.terminate()
+    process.wait(timeout=5)
+    port = free_port()
+    fallback = subprocess.Popen(
+        command(port),
+        cwd=cwd,
+        env=None if env is None else dict(env),
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.DEVNULL,
+    )
+    return fallback, port
