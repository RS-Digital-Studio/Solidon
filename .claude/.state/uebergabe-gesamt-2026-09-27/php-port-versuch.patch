+    slot = int(hashlib.sha256(run.encode("utf-8")).hexdigest(), 16) % slots
+    first = _FIRST_PORT + (slot * _WORKERS_PER_RUN + index) * _PORTS_PER_WORKER
     start = _next_port if _next_port is not None else first
