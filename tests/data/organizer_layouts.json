  {
    "name": "Besteckkorb.p3d",
    "data": {
      "version": 1,
      "basis": "outer",
      "layout": {
        "kind": "split",
        "id": "front_back",
        "axis": "y",
        "wall": "=@wall",
        "heights": {},
        "opening_radius": 0,
        "children": [
          {
            "kind": "split",
            "id": "left_right",
            "axis": "x",
            "wall": "=@wall",
            "heights": {},
            "opening_radius": 0,
            "children": [
              {
                "kind": "split",
                "id": "front_middle",
                "axis": "y",
                "wall": "=@wall",
                "heights": {
                  "1": "=@divider_h"
                },
                "opening_radius": "=@divider_opening_radius",
                "children": [
                  {
                    "kind": "cell",
                    "id": "front_left",
                    "width": "=@left_width",
                    "depth": "=@row_depth",
                    "radius": "=@pocket_radius"
                  },
                  {
                    "kind": "cell",
                    "id": "middle_left",
                    "width": "=@left_width",
                    "depth": "=@row_depth",
                    "radius": "=@pocket_radius"
                  }
                ]
              },
              {
                "kind": "cell",
                "id": "right",
                "width": "=@right_width",
                "depth": "=@row_depth*2+@wall",
                "radius": "=@right_radius"
              }
            ]
          },
          {
            "kind": "repeat",
            "id": "back_row",
            "axis": "x",
            "wall": "=@wall",
            "heights": {},
            "opening_radius": 0,
            "count": "=@back_columns",
            "child": {
              "kind": "cell",
              "id": "back_cell",
              "width": "=@back_cell_width",
              "depth": "=@row_depth",
              "radius": "=@pocket_radius"
            }
          }
        ]
      }
    },
    "values": {
      "wall": 3.0,
      "floor": 4.0,
      "height": 160.0,
      "grid": 15.0,
      "hole_d": 6.0,
      "foot_d": 13.0,
      "row_depth": 45.5,
      "divider_h": 100.0,
      "width": 180.0,
      "depth": 148.5,
      "pocket_radius": 3.26,
      "right_radius": 4.61,
      "left_width": 105.5,
      "right_width": 65.5,
      "back_cell_width": 56.0,
      "back_columns": 3,
      "divider_opening_radius": 1.3
    },
